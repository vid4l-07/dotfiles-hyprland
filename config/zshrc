# Git prompt
git_prompt_info() {
    git rev-parse --is-inside-work-tree &>/dev/null || return

	local correct="✔"
    local branch=""
    local git_status=""
    local ahead=0
    local behind=0
    local staged
    local modified
    local untracked
    local upstream

    branch=$(git branch --show-current 2>/dev/null)
    staged=$(git diff --cached --name-only | wc -l)
    modified=$(git diff --name-only | wc -l)
    untracked=$(git ls-files --others --exclude-standard | wc -l)
    upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)

    # Detached HEAD
    if [[ -z "$branch" ]]; then
        branch=$(git rev-parse --short HEAD 2>/dev/null)
    fi

    # Staged
    if (( staged > 0 )); then
        git_status+="%F{yellow}+${staged}%f"
    fi
	
    # Modified
    if (( modified > 0 )); then
        git_status+="%F{red}x${modified}$f"
    fi

    # Untracked
    if (( untracked > 0 )); then
        git_status+="%F{blue}?${untracked}%f"
    fi

	# Clean
	if [[ -z "$git_status" ]]; then
		git_status="%F{green}$correct%f"
	fi

    # Upstream
    if [[ -n "$upstream" ]]; then
        ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null)
        behind=$(git rev-list --count 'HEAD..@{upstream}' 2>/dev/null)
    fi

    local result="%F{black}${branch}%f"

    (( ahead > 0 )) && result+=" %F{blue}↑${ahead}%f"
    (( behind > 0 )) && result+=" %F{red}↓${behind}%f"
	[[ -n "$git_status" ]] && result+=" ${git_status}"


    print -n "$result"
}

