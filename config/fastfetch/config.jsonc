{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // "logo": {
    //     "type": "small",
    //     "padding": {
    //         "top": 1
    //     }
    // },
	"logo": {
	   "source": "$HOME/.config/fastfetch/ascii/squirtle.txt",
		"padding": {
		  "top": 1,
		  "right": 2
		},
		"height": 1
	},

    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
		{
			"type": "command",
            "key": "│ {#34}{icon}  distro {#keys}│",
			"text": "echo Fedora Linux"
            // "key": "│ {#34}{icon}  distro {#keys}│",
            // "type": "os"
        },
        {
			"type": "command",
            "key": "│ {#36}  wm     {#keys}│",
            // "type": "wm"
			"text": "echo $XDG_CURRENT_DESKTOP"
        },
        {
            "key": "│ {#36}󰇄  desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31}  term   {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32}  shell  {#keys}│",
            "type": "shell"
        },
        {
          "type": "command",
          "key": "│ {#33}󱦟  os age {#keys}│",
          "keyColor": "magenta",
          "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39}  colors {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
